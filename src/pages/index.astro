---
import { Image } from "astro:assets";
import starterkitCover from "../assets/products/starterkit/cover.png";
import BrandPrinciples from "../components/sections/BrandPrinciples.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { productCategories } from "../data/categories";
import { getProductsByCategory } from "../data/products";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Vantdard | Products built with care" description={site.description} canonicalPath="/">
<header class="hero"><div class="container hero__inner"><div><p class="eyebrow">Vantdard</p><h1>Products built with clarity, reliability and care.</h1><p class="lede">Vantdard develops high-quality products across different domains. Each one is focused, clearly presented and built to earn the same standard of trust.</p><div class="actions"><ButtonLink href="/products">Explore products</ButtonLink><ButtonLink href="/about" variant="secondary">About Vantdard</ButtonLink></div></div><figure class="hero__visual"><Image src={starterkitCover} alt="Cover of the Production-Ready Express + TypeScript StarterKit" widths={[640,960,1280]} sizes="(min-width:48rem) 50vw, 100vw" loading="eager" decoding="async" /></figure></div></header>
<section class="section section--surface" id="ecosystem"><div class="container"><SectionHeading eyebrow="Ecosystem" title="Different categories. One shared standard." description="Vantdard is not defined by a single industry. Explore the real product areas that make up the ecosystem today."/><div class="ecosystem-grid">{productCategories.map((category)=>{const categoryProducts=getProductsByCategory(category.id);return <article class="area"><div class="area__heading"><p class="area-index">0{category.order}</p><h3>{category.name}</h3><p>{category.shortDescription}</p><a href={`/products/${category.slug}`}>Explore {category.name}</a></div><div class="area__products">{categoryProducts.map((product)=><a class="product-preview" href={`/products/${product.slug}`}><div class="product-preview__image">{product.image&&<Image src={product.image.src} alt="" widths={[320,480,640]} sizes="(min-width:48rem) 24rem, 100vw" loading="lazy" decoding="async"/>}</div><span>{product.name}</span></a>)}</div></article>})}</div></div></section>
<section class="section"><div class="container"><SectionHeading eyebrow="Why Vantdard" title="A consistent expectation behind every product." description="The categories may differ, but the principles governing what carries the Vantdard name remain shared."/><BrandPrinciples/></div></section>
<section class="final-cta"><div class="container final-cta__inner"><div><h2>Explore the Vantdard ecosystem.</h2><p>Start with a category, then find the product designed for your specific need.</p></div><ButtonLink href="/products">Browse categories</ButtonLink></div></section>
</BaseLayout>
<style>
.hero{padding-block:clamp(var(--space-8),8vw,var(--space-10))}.hero__inner,.final-cta__inner{display:grid;gap:var(--space-7)}.hero h1{font-size:var(--text-hero)}.actions{margin-block-start:var(--space-6)}.hero__visual{min-width:0;margin:0;overflow:hidden;border:var(--border-width) solid var(--color-border-strong);background:var(--color-surface)}.hero__visual :global(img){display:block;width:100%;height:auto}.ecosystem-grid{display:grid;gap:var(--space-7)}.area{display:grid;gap:var(--space-6);padding-block:var(--space-6);border-block-start:var(--border-width) solid var(--color-border)}.area-index{margin-block-end:var(--space-3);color:var(--color-accent);font-family:var(--font-mono);font-size:var(--text-xs)}.area h3,.final-cta h2{font-size:var(--text-2xl);letter-spacing:-.03em}.area__heading>p:last-of-type{color:var(--color-foreground-muted)}.area__products{display:grid;gap:var(--space-4)}.product-preview{display:grid;grid-template-columns:minmax(6rem,9rem) minmax(0,1fr);gap:var(--space-4);align-items:center;color:inherit;font-weight:700;text-decoration:none}.product-preview__image{overflow:hidden;border:var(--border-width) solid var(--color-border);background:var(--color-background)}.product-preview__image :global(img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.final-cta{padding-block:clamp(var(--space-6),4vw,var(--space-8));border-block-start:var(--border-width) solid var(--color-border-strong);background:var(--color-surface-strong);color:var(--color-foreground)}.final-cta p{color:var(--color-foreground-muted)}@media(min-width:48rem){.hero__inner{grid-template-columns:repeat(2,minmax(0,1fr));align-items:center}.area{grid-template-columns:minmax(0,.8fr) minmax(18rem,1.2fr);align-items:start}.final-cta__inner{grid-template-columns:minmax(0,1fr) auto;align-items:center}}
</style>