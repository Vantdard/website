---
import LunarPrototype from "../components/experimental/LunarPrototype.astro";
import MusicExploration from "../components/music/MusicExploration.astro";
import { releases } from "../data/releases";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${site.name} | Artista musical`}
  description={site.description}
  canonicalPath="/"
  immersive
>
  <LunarPrototype publicMode />
  <MusicExploration releases={releases} />
</BaseLayout>
