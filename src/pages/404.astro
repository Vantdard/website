---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Página no encontrada | NODAM" description="La página solicitada no existe o cambió de ubicación." canonicalPath="/404" robots="noindex, follow">
  <section class="container not-found"><p class="eyebrow">404</p><h1>Esta página no está aquí.</h1><p class="lede">Puede haber cambiado de lugar o dejar de existir.</p><nav aria-label="Opciones para continuar"><a href="/">Volver al inicio</a><a href="/music">Explorar música</a></nav></section>
</BaseLayout>
<style>.not-found{display:grid;align-content:center;min-height:70vh;padding-block:var(--section-space)}nav{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-6);margin-block-start:var(--space-6)}nav a{min-height:2.75rem;font-weight:700}</style>
