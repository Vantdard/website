---
import { Image } from "astro:assets";
import animalsImage from "../../assets/products/cute-animals-expressions/Animals.png";
import coverImage from "../../assets/products/cute-animals-expressions/Cover.png";
import expressionsImage from "../../assets/products/cute-animals-expressions/Expressions.png";
import ProductFacts from "../../components/product/ProductFacts.astro";
import PurchaseOptions from "../../components/product/PurchaseOptions.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { getProductBySlug } from "../../data/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ProductEvidence } from "../../types/content";
const product = getProductBySlug("cute-animals-expressions");
if (!product || !product.licenseOptions) throw new Error("Cute Animals — Expressions product data is missing.");
const headerFacts = [...product.evidence, { label: "Formats", value: "PNG · JPG · WEBP" }] satisfies readonly ProductEvidence[];
const expressions = ["Happy", "Sad", "Sleeping", "Surprised", "Waving"];
---
<BaseLayout {...product.seo}>
  <header class="product-header"><div class="container product-header__grid"><div><p class="eyebrow">Digital Products · Cute Animals</p><h1>{product.name}</h1><p class="lede">{product.description}</p><p class="audience">Created for {product.audience?.toLowerCase()}</p></div><figure class="product-cover"><Image src={coverImage} alt="Cute Animals — Expressions cover featuring the illustrated animal collection" widths={[640,960,1280,1600]} sizes="(min-width:64rem) 50vw, 100vw" loading="eager" decoding="async" /></figure></div></header>

  <section class="section section--surface"><div class="container"><SectionHeading eyebrow="Collection" title="Nine characters. Five expressions each." description="A cohesive set of 45 illustrations for creative projects, content and finished products."/><ProductFacts facts={headerFacts}/></div></section>

  <section class="section"><div class="container visual-story"><div><SectionHeading eyebrow="Characters" title="Nine adorable animals." description="The collection includes Capybara, Cat, Dog, Duck, Fox, Frog, Koala, Panda and Rabbit."/><ul class="name-list">{product.includes.map((animal)=><li>{animal}</li>)}</ul></div><figure><Image src={animalsImage} alt="The nine illustrated animals included in Cute Animals — Expressions" widths={[640,960,1280]} sizes="(min-width:48rem) 55vw, 100vw" loading="lazy" decoding="async"/><figcaption>The complete character lineup included in the collection.</figcaption></figure></div></section>

  <section class="section section--surface"><div class="container visual-story visual-story--reverse"><figure><Image src={expressionsImage} alt="Examples of the happy, sad, sleeping, surprised and waving expressions" widths={[640,960,1280]} sizes="(min-width:48rem) 55vw, 100vw" loading="lazy" decoding="async"/><figcaption>Each animal is supplied in the same five expressive poses.</figcaption></figure><div><SectionHeading eyebrow="Expressions" title="A consistent expressive set." description="Every animal includes five distinct expressions ready for flexible use."/><ul class="name-list">{expressions.map((expression)=><li>{expression}</li>)}</ul></div></div></section>

  <section class="section"><div class="container license-section"><div><SectionHeading eyebrow="License options" title="Choose the license that matches your use." description="Both options are one-time purchases. Select the appropriate license through Payhip once the product link is available."/><div class="license-grid">{product.licenseOptions.map((option)=><article><p class="license-name">{option.name}</p><p class="license-price">{option.price.currency} {option.price.amount.toFixed(2)}</p><p>{option.summary}</p></article>)}</div></div><aside><h2>Commercial license boundary</h2><p>The Commercial Use license permits using the illustrations to create final products intended for sale.</p><p>It does not permit reselling, redistributing, sharing or sublicensing the original files, or versions that function essentially as substitutes for the original assets.</p></aside></div></section>

  <section class="section section--surface"><div class="container delivery"><div><SectionHeading eyebrow="Delivery" title="Ready in three image formats." description="The delivered collection includes PNG, JPG and WEBP files."/></div><div><h2>What to expect</h2><p>No product updates are promised. Support is limited to problems with the delivered files.</p><p>Refunds are handled according to Payhip's applicable terms.</p></div></div></section>

  <section class="section" id="purchase"><div class="container"><SectionHeading eyebrow="Purchase" title="Purchase through Payhip" description="Personal Use is USD 4.99 and Commercial Use is USD 9.99, each as a one-time payment."/><PurchaseOptions product={product}/></div></section>
</BaseLayout>
<style>
.product-header{padding-block:clamp(var(--space-8),8vw,var(--space-10))}.product-header__grid,.visual-story,.license-section,.delivery{display:grid;gap:var(--space-7)}.product-header h1{font-size:var(--text-hero)}.audience{margin-block-start:var(--space-5);color:var(--color-foreground-muted)}.product-cover,.visual-story figure{margin:0;overflow:hidden;border:var(--border-width) solid var(--color-border-strong);background:var(--color-surface)}.product-cover :global(img),.visual-story figure :global(img){display:block;width:100%;height:auto}.visual-story figcaption{padding:var(--space-3) var(--space-4);border-block-start:var(--border-width) solid var(--color-border);color:var(--color-foreground-muted);font-size:var(--text-sm)}.name-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(8rem,1fr));margin:0;padding:0;border-block-start:var(--border-width) solid var(--color-border);list-style:none}.name-list li{padding:var(--space-3) 0;border-block-end:var(--border-width) solid var(--color-border);font-weight:650}.license-grid{display:grid;gap:var(--space-4)}.license-grid article,.license-section aside{padding:var(--space-5);border:var(--border-width) solid var(--color-border)}.license-name{margin-block-end:var(--space-2);color:var(--color-accent);font-family:var(--font-mono);font-size:var(--text-xs);font-weight:700;text-transform:uppercase}.license-price{margin-block-end:var(--space-3);font-size:var(--text-2xl);font-weight:750}.license-grid article p:last-child,.license-section aside p,.delivery p{color:var(--color-foreground-muted)}.license-section aside h2,.delivery h2{font-size:var(--text-xl)}@media(min-width:48rem){.product-header__grid,.visual-story{grid-template-columns:repeat(2,minmax(0,1fr));align-items:center}.visual-story--reverse>figure{grid-column:1}.visual-story--reverse>div{grid-column:2;grid-row:1}.license-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.license-section{grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr);align-items:start}.delivery{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>