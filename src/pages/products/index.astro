---
import ButtonLink from "../../components/ui/ButtonLink.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { productCategories } from "../../data/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Products | Vantdard" description="Explore the current Vantdard product categories across Software and Digital Products." canonicalPath="/products">
<header class="container page-intro"><p class="eyebrow">Vantdard ecosystem</p><h1>Explore products by category.</h1><p>Each category organizes products with a related purpose while remaining part of the same Vantdard ecosystem.</p></header>
<section class="category-section"><div class="container"><SectionHeading eyebrow="Current categories" title="Choose an area to explore" description="Only categories with real, available products are shown."/><div class="category-grid">{productCategories.map((category)=><article class="category-card"><div><p class="category-index">0{category.order}</p><h2>{category.name}</h2><p class="category-description">{category.description}</p></div><ButtonLink href={`/products/${category.slug}`}>Explore {category.name}</ButtonLink></article>)}</div></div></section>
</BaseLayout>
