---
import BrandPrinciples from "../components/sections/BrandPrinciples.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About Vantdard" description={site.description} canonicalPath="/about">
  <header class="container page-intro">
    <p class="eyebrow">About Vantdard</p>
    <h1>Focused software foundations, built with engineering discipline.</h1>
    <p>{site.description}</p>
  </header>
  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="Purpose" title="What Vantdard creates" />
      <p class="lede">Vantdard builds defined software products that establish a reliable technical starting point without claiming to solve every application concern.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Principles" title="How the products are approached" />
      <BrandPrinciples />
    </div>
  </section>
  <section class="section section--surface">
    <div class="container current-product">
      <div>
        <p class="eyebrow">The current product</p>
        <h2>Production-Ready Express + TypeScript StarterKit</h2>
        <p>The Production-Ready Express + TypeScript StarterKit is Vantdard's current software foundation for backend projects.</p>
      </div>
      <ButtonLink href="/products/express-typescript-starterkit">View the StarterKit</ButtonLink>
    </div>
  </section>
</BaseLayout>
<style>
  .current-product { display: grid; gap: var(--space-6); align-items: center; }
  .current-product .eyebrow { margin-block-end: var(--space-3); color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .current-product h2 { max-width: 24ch; margin-block-end: var(--space-4); font-size: var(--text-2xl); letter-spacing: -0.03em; }
  .current-product p:last-child { margin-block-end: 0; color: var(--color-foreground-muted); }
  @media (min-width: 48rem) { .current-product { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
