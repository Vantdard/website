---
import { site } from "../../data/site";
import PrimaryNavigation from "../navigation/PrimaryNavigation.astro";
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label={`${site.name}, inicio`}>
      {site.name}
    </a>
    <PrimaryNavigation />
  </div>
</header>
<style>
  .site-header { border-block-end: var(--border-width) solid var(--color-border); }
  .header-inner { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); align-items: center; justify-content: space-between; min-height: 5rem; padding-block: var(--space-3); }
  .brand-link { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-foreground); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 850; letter-spacing: .2em; text-decoration: none; }
  .brand-link:hover { color: var(--color-accent); }
</style>
