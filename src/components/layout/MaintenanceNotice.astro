---
import { maintenance } from "../../data/maintenance";
import { site } from "../../data/site";
---

<main class="maintenance" id="main-content">
  <div class="maintenance__content">
    <p class="maintenance__eyebrow">Vantdard</p>
    <h1>{maintenance.title}</h1>
    <p class="maintenance__message">{maintenance.message}</p>
    <p class="maintenance__contact">
      For support, contact <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.
    </p>
  </div>
</main>

<style>
  :global(body) {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .maintenance {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(1.25rem, 5vw, 3rem);
  }

  .maintenance__content {
    width: min(100%, 44rem);
    padding-block: clamp(3rem, 10vw, 7rem);
    border-block: var(--border-width) solid #44443f;
  }

  .maintenance__eyebrow {
    margin-block-end: var(--space-4);
    color: #8eabff;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: var(--space-5);
    font-size: clamp(2.5rem, 8vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .maintenance__message {
    color: #c9c9c1;
    font-size: var(--text-lg);
  }

  .maintenance__contact {
    margin-block-start: var(--space-6);
    color: #c9c9c1;
    font-size: var(--text-sm);
  }

  a {
    color: #ffffff;
  }

  a:hover {
    color: #8eabff;
  }
</style>
