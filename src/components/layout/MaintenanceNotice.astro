---
import { maintenance } from "../../data/maintenance";
import { site } from "../../data/site";
---

<main class="maintenance" id="main-content">
  <div class="maintenance__content">
    <p class="maintenance__identity">{site.name}</p>
    <h1>{maintenance.title}</h1>
    <p class="maintenance__message">{maintenance.message}</p>
  </div>
</main>

<style>
  :global(body) {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .maintenance {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(1.25rem, 5vw, 3rem);
  }

  .maintenance__content {
    width: min(100%, 44rem);
    padding-block: clamp(3rem, 10vw, 7rem);
    border-block: var(--border-width) solid var(--color-border);
  }

  .maintenance__identity {
    margin-block-end: var(--space-6);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 850;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: var(--space-5);
    font-size: clamp(2.5rem, 8vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .maintenance__message {
    color: var(--color-foreground-muted);
    font-size: var(--text-lg);
  }
</style>
