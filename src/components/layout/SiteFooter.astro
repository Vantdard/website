---
import { primaryNavigation } from "../../data/navigation";
import { artist } from "../../data/artist";
import { site } from "../../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-about">
      <a class="footer-brand" href="/" aria-label={`${site.name}, inicio`}>{site.name}</a>
      <p>{artist.philosophy}</p>
    </div>
    <nav aria-labelledby="footer-explore"><h2 id="footer-explore">Explorar</h2><ul>{primaryNavigation.map((item)=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
  </div>
  <div class="container footer-bottom"><small>&copy; {year} {site.name}</small></div>
</footer>
<style>
  .site-footer { padding-block: var(--space-8) var(--space-5); border-block-start: var(--border-width) solid var(--color-border); background: var(--color-surface); }
  .footer-main { display: grid; gap: var(--space-7); }
  .footer-about { max-width: 30rem; }
  .footer-brand { display: inline-flex; color: var(--color-foreground); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 850; letter-spacing: .18em; text-decoration: none; }
  .footer-about p { margin-block: var(--space-4) 0; color: var(--color-foreground-muted); font-size: var(--text-sm); }
  h2 { margin-block-end: var(--space-4); color: var(--color-foreground); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .1em; text-transform: uppercase; }
  ul { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  nav a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-foreground-muted); }
  .footer-bottom { margin-block-start: var(--space-7); padding-block-start: var(--space-5); border-block-start: var(--border-width) solid var(--color-border); color: var(--color-foreground-muted); font-size: var(--text-sm); }
  @media (min-width: 48rem) { .footer-main { grid-template-columns: minmax(16rem, 2fr) minmax(10rem, 1fr); align-items: start; } }
</style>
