---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  loading = "lazy",
  sizes = "(min-width: 72rem) 34rem, (min-width: 48rem) 46vw, 100vw",
} = Astro.props;
---

<figure class="product-screenshot">
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1200, 1600]}
    sizes={sizes}
    loading={loading}
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .product-screenshot {
    min-width: 0;
    margin: 0;
  }

  .product-screenshot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-width) solid var(--color-border-strong);
    background: #101113;
  }

  figcaption {
    margin-block-start: var(--space-3);
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
  }
</style>
