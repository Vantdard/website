---
import { Image } from "astro:assets";
import type { Product } from "../../types/content";
import ButtonLink from "../ui/ButtonLink.astro";
interface Props { product: Product; }
const { product } = Astro.props;
const productPath = `/products/${product.slug}`;
const price = `${product.price.currency} ${product.price.amount.toFixed(2)}`;
---
<article class="product-card">
  {product.image && (
    <a class="product-card__visual" href={productPath} aria-label={`View ${product.shortName}`}>
      <Image
        src={product.image.src}
        alt={product.image.alt}
        widths={[480, 768, 1200]}
        sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 50vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <div class="product-card__body">
    <div>
      <p class="label">Backend StarterKit</p>
      <h3><a href={productPath}>{product.name}</a></h3>
      <p class="description">{product.shortDescription}</p>
      <ul class="technology-list" aria-label="Core technologies">
        {product.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
    <div class="product-card__footer">
      <p class="price"><strong>{price}</strong><span>One-time payment</span></p>
      <ButtonLink href={productPath} variant="secondary">View the StarterKit</ButtonLink>
    </div>
  </div>
</article>
<style>
  .product-card {
    display: grid; overflow: hidden; border: var(--border-width) solid var(--color-border);
    background: var(--color-background);
  }
  .product-card__visual { display: block; overflow: hidden; background: #090b0e; }
  .product-card__visual :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .product-card__body { display: grid; gap: var(--space-6); padding: clamp(var(--space-5), 4vw, var(--space-7)); }
  .label {
    margin-block-end: var(--space-3); color: var(--color-accent); font-family: var(--font-mono);
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }
  h3 { max-width: 25ch; margin-block-end: var(--space-4); font-size: var(--text-xl); letter-spacing: -0.025em; }
  h3 a { text-decoration: none; }
  .description { color: var(--color-foreground-muted); }
  .technology-list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-5) 0 0; padding: 0; list-style: none; }
  .technology-list li {
    padding: var(--space-1) var(--space-3); border: var(--border-width) solid var(--color-border);
    border-radius: 999px; color: var(--color-foreground-muted); font-family: var(--font-mono); font-size: var(--text-xs);
  }
  .product-card__footer {
    display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: end; justify-content: space-between;
    padding-block-start: var(--space-5); border-block-start: var(--border-width) solid var(--color-border);
  }
  .price { display: grid; margin: 0; }
  .price strong { font-size: var(--text-lg); }
  .price span { color: var(--color-foreground-muted); font-size: var(--text-sm); }
  @media (min-width: 64rem) {
    .product-card { grid-template-columns: minmax(20rem, 1fr) minmax(20rem, 0.9fr); }
    .product-card__visual :global(img) { height: 100%; min-height: 30rem; }
  }
</style>
