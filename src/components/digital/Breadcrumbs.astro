---
interface Item { label: string; href?: string; }
interface Props { items: readonly Item[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{items.map((item, index) => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}{index < items.length - 1 && <span aria-hidden="true">/</span>}</li>)}</ol></nav>
<style>
.breadcrumbs ol{display:flex;flex-wrap:wrap;gap:var(--space-2);margin:0 0 var(--space-7);padding:0;color:var(--color-foreground-muted);font-size:var(--text-sm);list-style:none}.breadcrumbs li{display:flex;gap:var(--space-2)}
</style>
