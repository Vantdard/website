---
import { Image } from "astro:assets";
import type { DigitalProductFamily, ResolvedDigitalCollection } from "../../types/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductFacts from "../product/ProductFacts.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
interface Props { collection: ResolvedDigitalCollection; family: DigitalProductFamily; related: readonly ResolvedDigitalCollection[]; }
const { collection, family, related } = Astro.props;
const facts = [
  { label: "Illustrations", value: String(collection.illustrationCount) },
  { label: "Animals", value: String(collection.animals.length) },
  { label: `${collection.variationsLabel[0].toUpperCase()}${collection.variationsLabel.slice(1)}`, value: String(collection.variations.length) },
  { label: "Formats", value: collection.formats.join(" · ") },
];
---
<BaseLayout {...collection.seo}>
<header class="collection-hero"><div class="container"><Breadcrumbs items={[{label:"Products",href:"/products"},{label:"Digital Products",href:"/products/digital-products"},{label:family.name,href:`/products/digital-products/${family.slug}`},{label:collection.shortName}]}/><div class:list={["collection-hero__grid",{"collection-hero__grid--text":!collection.cover}]}><div><p class="eyebrow">{family.name} collection</p><h1>{collection.name}</h1><p class="lede">{collection.description}</p><p class="audience">Made for {family.audience.toLowerCase()}</p></div>{collection.cover&&<figure><Image src={collection.cover.src} alt={collection.cover.alt} widths={[640,960,1280,1600]} sizes="(min-width:64rem) 52vw, 100vw" loading="eager" decoding="async" /></figure>}</div></div></header>
<section class="section section--surface"><div class="container"><SectionHeading eyebrow="At a glance" title={`One coordinated set. ${collection.illustrationCount} ready-to-use illustrations.`} description={`Every character appears in five ${collection.variationsLabel}, delivered in practical image formats.`}/><ProductFacts facts={facts}/></div></section>
{collection.gallery.length>0&&<section class="section"><div class="container"><SectionHeading eyebrow="Lookbook" title="See the collection as a complete visual system." description="Every preview shown here comes from the delivered collection."/><div class="gallery">{collection.gallery.map((image,index)=><figure class:list={{"gallery__wide":index===0}}><Image src={image.src} alt={image.alt} widths={[640,960,1280,1600]} sizes={index===0?"(min-width:64rem) 70vw, 100vw":"(min-width:48rem) 50vw, 100vw"} loading="lazy" decoding="async" />{image.caption&&<figcaption>{image.caption}</figcaption>}</figure>)}</div></div></section>}
<section class="section"><div class="container detail-grid"><div><SectionHeading eyebrow="Characters" title="Nine recurring animal characters." description="A consistent lineup makes the collection easy to combine across a project."/><ul class="name-list">{collection.animals.map((animal)=><li>{animal}</li>)}</ul></div><div><SectionHeading eyebrow={collection.variationsLabel} title={`Five distinct ${collection.variationsLabel}.`} description={`Each animal is provided in the same five ${collection.variationsLabel}.`}/><ul class="name-list">{collection.variations.map((variation)=><li>{variation}</li>)}</ul></div></div></section>
<section class="section section--surface"><div class="container"><SectionHeading eyebrow="License options" title="Choose the license that matches your use." description="Both options are one-time purchases."/><div class="license-layout"><div class="license-grid">{collection.licenseOptions.map((option)=><article><p class="license-name">{option.name}</p><p class="license-price">{option.price.currency} {option.price.amount.toFixed(2)}</p><p>{option.summary}</p></article>)}</div><aside><h2>Commercial license boundary</h2><p>The Commercial Use license permits using the illustrations to create final products intended for sale.</p><p>It does not permit reselling, redistributing, sharing or sublicensing the original files, or versions that function essentially as substitutes for the original assets.</p></aside></div></div></section>
<section class="purchase" id="purchase"><div class="container purchase__inner"><div><p class="eyebrow">Purchase</p><h2>Get {collection.name}</h2><p>Choose Personal Use for USD 4.99 or Commercial Use for USD 9.99 through Payhip.</p></div>{collection.purchaseUrl?<a class="purchase__button" href={collection.purchaseUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="outbound-purchase" data-family={family.slug} data-collection={collection.slug} data-cta-location="collection-purchase">Get {collection.name}</a>:<p class="availability">The Payhip purchase link will be added here once its final URL is available.</p>}</div><div class="container terms"><p>{collection.support}</p><p>{collection.updates}</p><p>{collection.refunds}</p></div></section>
<section class="section"><div class="container"><SectionHeading eyebrow="Continue exploring" title="More from Cute Animals" description="The same nine characters continue across related themes."/><div class="related">{related.map((item)=><article>{item.cover&&<a href={`/products/digital-products/${family.slug}/${item.slug}`}><Image src={item.cover.src} alt={`Cover of ${item.name}`} widths={[480,768]} sizes="(min-width:48rem) 28rem, 100vw" loading="lazy" decoding="async"/></a>}<p>{item.illustrationCount} illustrations</p><h3><a href={`/products/digital-products/${family.slug}/${item.slug}`}>{item.shortName}</a></h3><span>{item.variations.join(" · ")}</span></article>)}</div></div></section>
</BaseLayout>
<style>
.collection-hero{padding-block:clamp(var(--space-7),7vw,var(--space-10))}.collection-hero__grid{display:grid;gap:var(--space-7);align-items:center}.collection-hero__grid--text{max-width:var(--width-reading)}.collection-hero h1{font-size:var(--text-hero)}.collection-hero figure,.gallery figure{margin:0;overflow:hidden;border:var(--border-width) solid var(--color-border-strong);background:var(--color-surface)}.collection-hero figure :global(img),.gallery :global(img),.related :global(img){display:block;width:100%;height:auto}.audience{margin-block-start:var(--space-5);color:var(--color-foreground-muted)}.gallery{display:grid;gap:var(--space-5)}.gallery figcaption{padding:var(--space-3) var(--space-4);border-block-start:var(--border-width) solid var(--color-border);color:var(--color-foreground-muted);font-size:var(--text-sm)}.detail-grid,.license-layout{display:grid;gap:var(--space-7)}.name-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(8rem,1fr));margin:0;padding:0;border-block-start:var(--border-width) solid var(--color-border);list-style:none}.name-list li{padding:var(--space-3) 0;border-block-end:var(--border-width) solid var(--color-border);font-weight:650}.license-grid{display:grid;gap:var(--space-4)}.license-grid article,.license-layout aside{padding:var(--space-5);border:var(--border-width) solid var(--color-border);background:var(--color-background)}.license-name{color:var(--color-accent);font-family:var(--font-mono);font-size:var(--text-xs);font-weight:700;text-transform:uppercase}.license-price{font-size:var(--text-2xl);font-weight:750}.license-layout p{color:var(--color-foreground-muted)}.purchase{padding-block:clamp(var(--space-7),7vw,var(--space-9));background:var(--color-foreground);color:var(--color-background)}.purchase__inner{display:grid;gap:var(--space-6);align-items:center}.purchase h2{font-size:var(--text-2xl)}.purchase__inner p{color:#d5d5cd}.purchase__button{display:inline-flex;min-height:3rem;align-items:center;justify-content:center;padding:var(--space-3) var(--space-5);border-radius:var(--radius-sm);background:var(--color-accent);color:#fff;font-weight:700;text-decoration:none}.purchase__button:hover{background:#fff;color:var(--color-foreground)}.availability{margin:0;padding:var(--space-4);border:1px solid #5a5a54}.terms{display:grid;gap:var(--space-2);margin-block-start:var(--space-6);padding-block-start:var(--space-5);border-block-start:1px solid #44443f;color:#bdbdb6;font-size:var(--text-sm)}.terms p{margin:0}.related{display:grid;gap:var(--space-5)}.related article{padding-block-start:var(--space-4);border-block-start:var(--border-width) solid var(--color-border)}.related article>a{display:block;margin-block-end:var(--space-4);overflow:hidden;border:var(--border-width) solid var(--color-border)}.related p{margin:0;color:var(--color-accent);font-family:var(--font-mono);font-size:var(--text-xs);text-transform:uppercase}.related h3{margin:var(--space-2) 0;font-size:var(--text-xl)}.related h3 a{text-decoration:none}.related span{color:var(--color-foreground-muted);font-size:var(--text-sm)}@media(min-width:48rem){.collection-hero__grid:not(.collection-hero__grid--text){grid-template-columns:repeat(2,minmax(0,1fr))}.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery__wide{grid-column:1/-1}.detail-grid{grid-template-columns:1.1fr .9fr}.license-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.license-layout{grid-template-columns:1.4fr .6fr}.purchase__inner{grid-template-columns:minmax(0,1fr) auto}.terms{grid-template-columns:repeat(3,minmax(0,1fr))}.related{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>


