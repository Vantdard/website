---
import SiempreVuelvesCinematicPlayer from "./SiempreVuelvesCinematicPlayer.astro";

interface Props {
  audioFallback?: string;
}

const { audioFallback } = Astro.props;
---

<div class="stage-36">
  <SiempreVuelvesCinematicPlayer audioFallback={audioFallback} />
  <button class="view-toggle" type="button" data-view-toggle aria-label="Volver a la habitación">
    <svg class="view-icon view-icon-room" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4h6v2H6v4H4V4Zm10 0h6v6h-2V6h-4V4ZM4 14h2v4h4v2H4v-6Zm14 0h2v6h-6v-2h4v-4Z" />
    </svg>
    <svg class="view-icon view-icon-window" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 3v2H5v2H3V3h4Zm10 0h4v4h-2V5h-2V3ZM3 17h2v2h2v2H3v-4Zm16 0h2v4h-4v-2h2v-2ZM8 8h8v8H8V8Z" />
    </svg>
    <span data-view-label>Volver a la habitación</span>
  </button>
</div>

<script>
  const stage = document.querySelector<HTMLElement>(".stage-36");
  const player = stage?.querySelector<HTMLElement>("[data-sv-player]");
  const console = stage?.querySelector<HTMLElement>(".player-console");
  const audio = stage?.querySelector<HTMLAudioElement>("[data-audio]");
  const toggle = stage?.querySelector<HTMLButtonElement>("[data-view-toggle]");
  const label = toggle?.querySelector<HTMLElement>("[data-view-label]");

  if (player && console && toggle && label) {
    let manualView: "room" | "window" | null = null;
    console.append(toggle);

    const setView = (view: "room" | "window") => {
      const showsWindow = view === "window";
      player.dataset.engaged = String(showsWindow);
      toggle.dataset.view = view;
      label.textContent = showsWindow ? "Volver a la habitación" : "Acercarse a la ventana";
      toggle.setAttribute(
        "aria-label",
        showsWindow ? "Volver a la habitación" : "Acercarse a la ventana",
      );
      toggle.setAttribute("aria-pressed", String(showsWindow));
    };

    toggle.addEventListener("click", () => {
      manualView = player.dataset.engaged === "true" ? "room" : "window";
      setView(manualView);
    });

    if (audio) {
      audio.addEventListener("play", () => {
        const requestedView = manualView;
        if (requestedView) queueMicrotask(() => setView(requestedView));
        else setView("window");
      });

      audio.addEventListener("ended", () => {
        manualView = null;
        setView("room");
      });
    }

    setView("room");
  }
</script>

<style>
  .stage-36 > .view-toggle { display: none; }

  .stage-36 :global(.player-console) {
    top: 50%;
    right: auto;
    bottom: auto;
    left: clamp(1.5rem, 6vw, 4.5rem);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "identity"
      "transport"
      "timeline"
      "volume"
      "view";
    align-content: center;
    width: 23.125rem;
    min-height: 23.125rem;
    padding: 1.35rem;
    gap: 0.9rem;
    border: 1px solid rgb(255 232 200 / 16%);
    border-radius: 1.25rem;
    background: linear-gradient(145deg, rgb(18 13 10 / 13%), rgb(3 7 10 / 5%));
    box-shadow:
      inset 0 1px rgb(255 238 214 / 10%),
      0 1rem 3rem rgb(0 0 0 / 10%);
    translate: 0 -50%;
    backdrop-filter: none;
  }

  .stage-36 :global(.player-console::before) {
    position: absolute;
    inset: 0.45rem 16% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(248 203 146 / 58%), transparent);
    content: "";
  }

  .stage-36 :global(.track-identity) {
    grid-area: identity !important;
    text-align: center;
  }

  .stage-36 :global(.track-identity p) {
    color: #fff8ef;
    font-size: 1.9rem;
    text-shadow: 0 2px 12px rgb(0 0 0 / 82%);
  }

  .stage-36 :global(.track-identity span) {
    color: #f3b86f;
    font-size: 0.82rem;
    text-shadow: 0 1px 8px rgb(0 0 0 / 88%);
  }

  .stage-36 :global(.transport) {
    grid-area: transport !important;
    justify-self: center;
    gap: 0.55rem;
  }

  .stage-36 :global(.timeline) {
    grid-area: timeline !important;
    width: 100%;
    gap: 0.85rem;
  }

  .stage-36 :global(.volume-control) {
    grid-area: volume !important;
    justify-self: center;
    width: min(100%, 13rem);
  }

  .stage-36 :global(.audio-availability) {
    grid-area: transport;
    max-width: 18rem;
    margin: 0;
    justify-self: center;
    color: #fff5e8;
    font-size: 0.95rem;
    text-align: center;
    text-shadow: 0 1px 8px rgb(0 0 0 / 92%);
  }

  .stage-36 :global(.view-toggle) {
    grid-area: view;
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    align-items: center;
    justify-self: center;
    gap: 0.5rem;
    border: 1px solid rgb(246 218 180 / 22%);
    border-radius: 999px;
    background: rgb(3 5 9 / 10%);
    color: rgb(255 246 234 / 90%);
    cursor: pointer;
    font-size: 0.78rem;
    line-height: 1;
    text-shadow: 0 1px 7px rgb(0 0 0 / 88%);
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }

  .stage-36 :global(.view-toggle:hover) {
    border-color: rgb(239 173 95 / 58%);
    background: rgb(239 173 95 / 11%);
    color: #fff8ef;
  }

  .stage-36 :global(.view-toggle:focus-visible) {
    outline: 2px solid #f7d7ad;
    outline-offset: 3px;
  }

  .stage-36 :global(.view-icon) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .stage-36 :global(.view-icon-window),
  .stage-36 :global(.view-toggle[data-view="room"] .view-icon-room) { display: none; }

  .stage-36 :global(.view-toggle[data-view="room"] .view-icon-window) { display: block; }

  .stage-36 :global(.transport button),
  .stage-36 :global(.volume-control button) {
    width: 3.15rem;
    height: 3.15rem;
    border-color: rgb(246 218 180 / 30%);
    background: rgb(3 5 9 / 13%);
    box-shadow: inset 0 1px rgb(255 255 255 / 10%), 0 2px 10px rgb(0 0 0 / 16%);
    text-shadow: 0 1px 6px rgb(0 0 0 / 90%);
    transition: border-color 180ms ease, background 180ms ease, scale 180ms ease;
  }

  .stage-36 :global(.transport button:hover),
  .stage-36 :global(.volume-control button:hover) {
    border-color: rgb(239 173 95 / 68%);
    background: rgb(239 173 95 / 13%);
  }

  .stage-36 :global(.transport button:active),
  .stage-36 :global(.volume-control button:active) { scale: 0.95; }

  .stage-36 :global(.play-button) {
    width: 4.05rem !important;
    height: 4.05rem !important;
    border-color: #f7d7ad !important;
    background: linear-gradient(145deg, #fff7eb, #e8ad65) !important;
    box-shadow: 0 0.55rem 1.7rem rgb(213 138 58 / 28%) !important;
  }

  .stage-36 :global(.play-button svg),
  .stage-36 :global(.volume-control svg) {
    width: 1.55rem;
    height: 1.55rem;
  }

  .stage-36 :global(.transport-button span) { font-size: 0.8rem; }

  .stage-36 :global(input[type="range"]) { accent-color: #efa958; }
  .stage-36 :global(.timeline output) {
    color: #fff5e8;
    font-size: 0.82rem;
    text-shadow: 0 1px 7px rgb(0 0 0 / 92%);
  }

  .stage-36 :global(.volume-control input) { max-width: 8rem; }

  .stage-36 :global(.player-status) {
    right: 0.75rem;
    border: 1px solid rgb(255 177 153 / 24%);
    border-radius: 0.55rem;
    background: rgb(24 10 8 / 90%);
  }

  .stage-36 :global(.lyric-stage) {
    top: 50%;
    right: clamp(1.5rem, 6vw, 4.5rem);
    left: auto;
    width: min(29vw, 22rem);
    padding: 0;
    border: 0;
    background: none;
    translate: 0 -50%;
  }

  .stage-36 :global(.lyric-stage p) {
    color: #fff8ef;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 3vw, 2.75rem);
    line-height: 1.16;
    text-shadow: 0 2px 15px #000, 0 0 38px rgb(0 0 0 / 92%);
    text-wrap: balance;
  }

  @media (max-width: 48rem) {
    .stage-36 :global(.player-console) {
      top: auto;
      bottom: max(0.5rem, env(safe-area-inset-bottom));
      left: 50%;
      width: min(23.125rem, calc(100% - 1rem));
      min-height: min(23.125rem, calc(100vw - 1rem));
      padding: 1rem;
      gap: 0.7rem;
      border-radius: 1rem;
      translate: -50% 0;
    }

    .stage-36 :global(.transport-button) { display: grid !important; }

    .stage-36 :global(.lyric-stage) {
      top: 12%;
      right: auto;
      left: 50%;
      width: min(88vw, 24rem);
      translate: -50% 0;
    }

    .stage-36 :global(.lyric-stage p) { font-size: clamp(1.45rem, 7vw, 2.25rem); }
  }

  @media (max-width: 24rem) and (max-height: 44rem) {
    .stage-36 :global(.player-console) {
      width: calc(100% - 0.75rem);
      min-height: calc(100vw - 0.75rem);
      padding: 0.65rem;
      gap: 0.42rem;
    }

    .stage-36 :global(.track-identity p) { font-size: 1.5rem; }

    .stage-36 :global(.transport button),
    .stage-36 :global(.volume-control button) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .stage-36 :global(.play-button) {
      width: 3.35rem !important;
      height: 3.35rem !important;
    }

    .stage-36 :global(.view-toggle) {
      min-height: 2.4rem;
      padding: 0.4rem 0.7rem;
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-36 :global(.transport button),
    .stage-36 :global(.volume-control button),
    .stage-36 :global(.view-toggle) { transition: none; }
  }
</style>
