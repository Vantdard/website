---
import { getImage } from "astro:assets";
import nodamIdentity from "../assets/brand/nodam/Logo_V2.png";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import MaintenanceNotice from "../components/layout/MaintenanceNotice.astro";
import { maintenance } from "../data/maintenance";
import { site } from "../data/site";
import "../styles/global.css";
import type { PageMetadata } from "../types/site";

interface Props extends PageMetadata {
  immersive?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogImageAlt,
  ogType = "website",
  robots = "index, follow",
  immersive = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, site.origin);
const favicon = await getImage({ src: nodamIdentity, width: 64, height: 64, fit: "contain", format: "png" });
const defaultOgImage = await getImage({ src: nodamIdentity, width: 1200, height: 1200, fit: "contain", format: "webp", quality: 88 });
const ogImageUrl = new URL(ogImage ?? defaultOgImage.src, site.origin);
const showMaintenance = maintenance.enabled && !import.meta.env.DEV;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={maintenance.enabled ? "noindex, nofollow" : robots} />
    <meta name="theme-color" content="#09090b" />
    <meta name="p:domain_verify" content="1795793307e175ee322b8297c3c0a6e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={ogImageAlt ?? "Identidad visual de NODAM"} />
      </>
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? "Identidad visual de NODAM"} />
    <slot name="head" />
  </head>
  <body>
    {
      showMaintenance ? (
        <MaintenanceNotice />
      ) : immersive ? (
        <>
          <a class="skip-link" href="#main-content">Saltar al contenido</a>
          <main id="main-content"><slot /></main>
        </>
      ) : (
        <>
          <a class="skip-link" href="#main-content">Saltar al contenido</a>
          <SiteHeader />
          <main id="main-content">
            <slot />
          </main>
          <SiteFooter />
        </>
      )
    }
  </body>
</html>
